# --- Frontend (Vite) ---
# Base URL of the Flask API, including the /api/v1 prefix.
# Development:
VITE_API_BASE_URL=http://localhost:5001/api/v1
# Production (Vercel) — set to your Render backend URL, e.g.:
# VITE_API_BASE_URL=https://kimi-earth-sentinel-api.onrender.com/api/v1
# Legacy alias (still honoured as a fallback): VITE_API_URL
