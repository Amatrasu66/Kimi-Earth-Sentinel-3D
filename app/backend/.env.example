# Copy to .env and fill in real values. Never commit .env.
FLASK_ENV=production
SECRET_KEY=change-me-in-production
# Listen port: PORT wins (Render injects it); FLASK_PORT is the local fallback.
PORT=5001
# FLASK_PORT=5001

# Comma-separated list of allowed browser origins for /api/*.
# Development default allows the Vite dev server.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Process-local in-memory cache (no database required).
# CACHE_DEFAULT_TIMEOUT is the fallback TTL; per-layer TTLs are in code.
CACHE_DEFAULT_TIMEOUT=300

# Upstream provider base URLs (defaults work without changes)
USGS_API_URL=https://earthquake.usgs.gov
NASA_EONET_URL=https://eonet.gsfc.nasa.gov/api/v3
NASA_FIRMS_URL=https://firms.modaps.eosdis.nasa.gov/api
NASA_GIBS_URL=https://gibs.earthdata.nasa.gov
OPEN_METEO_URL=https://api.open-meteo.com/v1
AIRNOW_API_URL=https://www.airnowapi.org/aq/observation

# Provider API keys (server-side only — never expose to the frontend).
# When absent, the affected layers return clearly-labelled SIMULATED data.
AIRNOW_API_KEY=
NASA_FIRMS_API_KEY=

# Outbound HTTP timeout in seconds for provider calls.
REQUEST_TIMEOUT=15

# In-process cache warming (no workers). Set to false to disable.
SCHEDULER_ENABLED=true
# Test/CI only: set to 1 to skip starting APScheduler.
# DISABLE_SCHEDULER=1
